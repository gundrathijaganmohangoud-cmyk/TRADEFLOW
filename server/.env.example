# PostgreSQL connection string used by Prisma.
# For Neon/managed Postgres use the POOLED endpoint (-pooler host) for runtime queries.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradeflow?schema=public"

# Direct (non-pooled) connection - used by Prisma Migrate for the shadow database.
# For Neon this is the same host WITHOUT "-pooler". Required when using a pooled DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tradeflow?schema=public"

# Secret used to sign JWT access tokens (change this in production!)
JWT_SECRET="tradeflow-dev-jwt-secret-change-me"

# Port the API server listens on
PORT=4000

# Allowed CORS origin (the frontend dev server)
CORS_ORIGIN=http://localhost:5173